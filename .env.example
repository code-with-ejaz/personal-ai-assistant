# Set strong unique secrets before starting; never commit this file.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/muse
SESSION_SECRET=replace-with-at-least-32-random-characters
# 32-byte key encoded as 64 hex characters; encrypts Google OAuth tokens at rest.
APP_ENCRYPTION_KEY=replace-with-64-hex-characters
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional Google OAuth. Configure the exact callback URI in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
